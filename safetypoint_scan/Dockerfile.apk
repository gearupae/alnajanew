# Build APK without local Flutter. From repository root:
#
#   docker build -f safetypoint_scan/Dockerfile.apk -t safetypoint-scan-apk .
#   id=$(docker create safetypoint-scan-apk)
#   docker cp "$id:/src/safetypoint_scan/example/build/app/outputs/flutter-apk/app-release.apk" ./safetypoint-scan.apk
#   docker rm "$id"
#
FROM ghcr.io/cirruslabs/flutter:stable
WORKDIR /src
COPY safetypoint_scan /src/safetypoint_scan
WORKDIR /src/safetypoint_scan/example
RUN flutter create . --project-name safetypoint_scan_example --org com.safetypoint
RUN flutter pub get
RUN sed -i 's/<application/<application android:usesCleartextTraffic="true" /' android/app/src/main/AndroidManifest.xml
RUN flutter build apk --release
